# --- Core ---
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://bridge:bridge@db:5432/bridge

# --- Google OAuth ---
# Consola de Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Extra Google OAuth clients (other Workspace orgs), JSON array:
# [{"name": "sancor", "client_id": "...", "client_secret": "..."}]
GOOGLE_EXTRA_CLIENTS=[]

# --- Microsoft OAuth ---
# Azure Portal > App registrations > New registration
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" para cuentas personales/corporativas; o tu tenant ID
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# --- Published Outlook ICS (read-only, no OAuth) ---
# Outlook Web → Settings → Calendar → Shared calendars → Publish → copiar la URL .ics
OUTLOOK_ICS_URL=

# --- Sync ---
SYNC_INTERVAL_MINUTES=15
SYNC_LOOKBACK_DAYS=30
SYNC_LOOKAHEAD_DAYS=60

# --- Working hours (default) ---
DEFAULT_WORK_START=09:00
DEFAULT_WORK_END=18:00
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires